#!/bin/bash
# The java binary of the Java 8 that install_java8 installs. /usr/bin/java is the newest Java on the system, and
# Airsonic (Spring 4) does not start on Java 17 or newer
java8_bin() {
    update-alternatives --list java 2> /dev/null | grep -m1 -E '/(temurin-8-jdk|adoptopenjdk-8-hotspot|java-8-openjdk)[^/]*/'
}
export -f java8_bin

install_java8() {
    codename=$(_os_codename)
    distribution=$(_os_distro)
    if [[ $distribution == "ubuntu" ]]; then
        apt_install openjdk-8-jre
    elif [[ $distribution == "debian" ]]; then
        case $codename in
            *)
                # adoptopenjdk.jfrog.io is gone: its leftover source makes every apt update fail
                rm -f /etc/apt/sources.list.d/adoptopenjdk.list /usr/share/keyrings/adoptopenjdk-archive-keyring.gpg
                echo_progress_start "Adding temurin repository"
                apt_key_install https://packages.adoptium.net/artifactory/api/gpg/key/public /usr/share/keyrings/temurin-archive-keyring.gpg || {
                    echo_error "The Temurin signing key could not be downloaded"
                    exit 1
                }
                echo "deb [signed-by=/usr/share/keyrings/temurin-archive-keyring.gpg] https://packages.adoptium.net/artifactory/deb/ ${codename} main" > /etc/apt/sources.list.d/temurin.list
                echo_progress_done "temurin repos enabled"
                apt_update
                apt_install temurin-8-jdk
                ;;
        esac
    fi
}

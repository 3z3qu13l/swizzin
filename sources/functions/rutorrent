#!/bin/bash

function rutorrent_install() {
    apt_install sox geoip-database p7zip-full zip unzip php-bcmath

    mkdir -p /srv
    if [[ ! -d /srv/rutorrent ]]; then
        echo_progress_start "Cloning ruTorrent"
        # Get current stable ruTorrent version
        release=$(git ls-remote --tags --refs https://github.com/novik/ruTorrent.git | awk '{sub("refs/tags/", ""); print $2 }' | grep -v beta | sort -Vr | head -n1)
        git clone --recurse-submodules --depth 1 -b ${release} https://github.com/Novik/ruTorrent.git /srv/rutorrent >> "$log" 2>&1 || {
            echo_error "Failed to clone ruTorrent"
            exit 1
        }
        rm -rf /srv/rutorrent/plugins/throttle
        rm -rf /srv/rutorrent/plugins/_cloudflare
        rm -rf /srv/rutorrent/plugins/dump
        rm -rf /srv/rutorrent/plugins/extratio
        rm -rf /srv/rutorrent/plugins/rpc
        rm -rf /srv/rutorrent/plugins/geoip
        rm -rf /srv/rutorrent/conf/config.php
        echo_progress_done "ruTorrent cloned"
    fi

    echo_progress_start "Cloning some popular themes and plugins"
    sed -i 's/useExternal = false;/useExternal = "mktorrent";/' /srv/rutorrent/plugins/create/conf.php
    sed -i 's/pathToCreatetorrent = '\'\''/pathToCreatetorrent = '\''\/usr\/bin\/mktorrent'\''/' /srv/rutorrent/plugins/create/conf.php
    sed -i "s/\$pathToExternals\['sox'\] = ''/\$pathToExternals\['sox'\] = '\/usr\/bin\/sox'/g" /srv/rutorrent/plugins/spectrogram/conf.php

    . /etc/swizzin/sources/functions/utils
    install_rar

    if [[ ! -d /srv/rutorrent/plugins/filemanager ]]; then
        git clone https://github.com/nelu/rutorrent-filemanager /srv/rutorrent/plugins/filemanager >> ${log} 2>&1 || {
            echo_error "git of file-manager plugin to main plugins seems to have failed"
        }
        rutorrent_fm_config
    fi

    if [[ ! -d /srv/rutorrent/plugins/ratiocolor ]]; then
        git clone https://github.com/Gyran/rutorrent-ratiocolor /srv/rutorrent/plugins/ratiocolor >> "$log" 2>&1
        sed -i "s/changeWhat = \"cell-background\";/changeWhat = \"font\";/g" /srv/rutorrent/plugins/ratiocolor/init.js || {
            echo_error "git of ratio plugin to main plugins seems to have failed"
        }
    fi

    if [[ ! -d /srv/rutorrent/plugins/geoip2 ]]; then
        git clone https://github.com/Micdu70/geoip2-rutorrent /srv/rutorrent/plugins/geoip2 >> ${log} 2>&1 || {
            echo_error "git of geoip2 plugin to main plugins seems to have failed"
        }
    fi

    if [[ ! -d /srv/rutorrent/plugins/theme/themes/club-QuickBox ]]; then
        rutorrent_club_quickbox
    fi

    echo_progress_done "Plugins downloaded"

    if [[ -f /install/.quota.lock ]] && [[ -z $(grep quota /srv/rutorrent/plugins/diskspace/action.php) ]]; then
        rutorrent_fix_quota
    fi

    cat > /srv/rutorrent/conf/config.php << 'RUC'
<?php
	// configuration parameters

	// for snoopy client
	$httpUserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/109.0.0.0 Safari/537.36';
	$httpTimeOut = 30; // in seconds
	$httpUseGzip = true;
	$httpIP = null;				// IP string. Or null for any.
	$httpProxy = array
	(
		'use' 	=> false,
		'proto'	=> 'http',		// 'http' or 'https'
		'host'	=> 'PROXY_HOST_HERE',
		'port'	=> 3128
	);

	// for xmlrpc actions
	$rpcTimeOut = 5; // in seconds
	$rpcLogCalls = false;
	$rpcLogFaults = true;

	// for php
	$phpUseGzip = false;
	$phpGzipLevel = 2;

	$schedule_rand = 10;			// rand for schedulers start, +0..X seconds

	$do_diagnostic = true;			// Diagnose ruTorrent. Recommended to keep enabled, unless otherwise required.
	$al_diagnostic = true;			// Diagnose auto-loader. Set to "false" to make composer plugins work.
	
	$log_file = '/tmp/errors.log';		// path to log file (comment or leave blank to disable logging)

	$saveUploadedTorrents = true;		// Save uploaded torrents to profile/torrents directory or not
	$overwriteUploadedTorrents = false;     // Overwrite existing uploaded torrents in profile/torrents directory or make unique name

	//$topDirectory = '/';			// Upper available directory. Absolute path with trail slash.
	$forbidUserSettings = false;

	//$scgi_port = 5000;
	//$scgi_host = "127.0.0.1";

	// For web->rtorrent link through unix domain socket 
	// (scgi_local in rtorrent conf file), change variables 
	// above to something like this:
	//
	// $scgi_port = 0;
	// $scgi_host = "unix:///tmp/rpc.socket";

	//$XMLRPCMountPoint = "/RPC2";		// DO NOT DELETE THIS LINE!!! DO NOT COMMENT THIS LINE!!!
	
	$throttleMaxSpeed = 327625*1024;	// DO NOT EDIT THIS LINE!!! DO NOT COMMENT THIS LINE!!!
	// Can't be greater then 327625*1024 due to limitation in libtorrent ResourceManager::set_max_upload_unchoked function.

	$pathToExternals = array(
		"php" 	=> '',			// Something like /usr/bin/php. If empty, will be found in PATH.
		"curl"	=> '',			// Something like /usr/bin/curl. If empty, will be found in PATH.
		"gzip"	=> '',			// Something like /usr/bin/gzip. If empty, will be found in PATH.
		"id"	=> '',			// Something like /usr/bin/id. If empty, will be found in PATH.
		"stat"	=> '',			// Something like /usr/bin/stat. If empty, will be found in PATH.
	);
	
	$localHostedMode = true; 		// Set to true if rTorrent is hosted on the SAME machine as ruTorrent
	
	$cachedPluginLoading = false;	// Set to true to enable rapid cached loading of ruTorrent plugins	
                                    // Required to clear web browser cache when upgrading versions

	$localhosts = array( 			// list of local interfaces
		"127.0.0.1",
		"localhost",
	);

	$profilePath = '../../share';		// Path to user profiles
	$profileMask = 0770;			// Mask for files and directory creation in user profiles.
						// Both Webserver and rtorrent users must have read-write access to it.
						// For example, if Webserver and rtorrent users are in the same group then the value may be 0770.

	$tempDirectory = null;			// Temp directory. Absolute path with trail slash. If null, then autodetect will be used.

	$canUseXSendFile = false;		// If true then use X-Sendfile feature if it exist

	$locale = "UTF8";

	$enableCSRFCheck = false;		// If true then Origin and Referer will be checked
	$enabledOrigins = array();		// List of enabled domains for CSRF check (only hostnames, without protocols, port etc.).
					            	// If empty, then will retrieve domain from HTTP_HOST / HTTP_X_FORWARDED_HOST
RUC
}

# ruTorrent's code belongs to root: owned by www-data, a PHP bug that writes files (path traversal, upload)
# could rewrite php/initplugins.php, which every rTorrent runs as its user. A bug that runs code as www-data
# still reaches every rTorrent: www-data drives them through their socket, which runs commands.
# Each user's profile (share/users/<user>) and conf are shared by www-data and that user only, profiles were
# 0777. A link a user places in their profile is not followed once share/users is mounted nosymfollow.
# www-data and the users write share/users, so root never walks a profile: each account sets the ACL on its
# own files, a link or hard link placed there then only reaches what that account could already change.
function rutorrent_perms() {
    local r=/srv/rutorrent
    [[ -d $r && ! -L $r ]] || return 0
    # box update and box rtx both call it
    {
        flock -w 600 9 || return 1
        _rutorrent_perms
    } 9> /run/swizzin-rutorrent-perms.lock
}

function _rutorrent_perms() {
    local r=/srv/rutorrent g d u l t main_git="" theme=/srv/rutorrent/plugins/theme/themes/club-QuickBox theme_git="" probe tag
    # without ACLs, share/users would end up closed to www-data: nothing is changed
    probe=$(mktemp -p "$r") || return 1
    if ! setfacl -m u:www-data:r "$probe" 2>> "$log"; then
        rm -f "$probe"
        echo_warn "ACLs do not work on $r, ruTorrent keeps its permissions"
        return 1
    fi
    rm -f "$probe"

    # git, run as root, must never use a .git folder www-data could prepare (hooks, fsmonitor...): those
    # are dropped once the tree is root's, ruTorrent's own and the theme's cloned again below
    local gits=()
    readarray -d '' gits < <(find "$r" -path "$r/share" -prune -o -name .git ! -user root -prune -print0)
    if [[ -d $r/.git && $(stat -c %U "$r/.git") != root ]]; then
        # read as www-data, whose folder it is, and kept by root for another try if the fetch fails
        tag=$(cd / && timeout 30 setpriv --reuid=www-data --regid=www-data --clear-groups -- git -c core.fsmonitor= -C "$r" describe --tags --abbrev=0 2> /dev/null)
        if [[ $tag =~ ^v?[0-9][0-9A-Za-z.+-]*$ ]]; then echo "$tag" > /install/.rutorrent.tag; fi
    fi

    # one entry at a time from the top: a folder is root's, and no longer writable by others, before what it
    # holds is changed, so nothing can be swapped under it. A file with other hard links may be one www-data
    # placed there: it is replaced by a copy, which ends the link
    find "$r" -path "$r/share" -prune -o -type f -links +1 \
        -exec sh -c 'cp -p -- "$1" "$1.swizzin" && chown root:root -- "$1.swizzin" && chmod go-w -- "$1.swizzin" && mv -f -- "$1.swizzin" "$1"' sh {} \; \
        -o -type f -links +1 -fprintf /dev/stderr 'Could not replace %p, which has other hard links\n' -o \
        ! -user root \( -type l -exec chown -h root:root {} \; -o -exec chown root:root {} \; -exec chmod go-w {} \; \)
    # a link out of the code could still lead to what www-data writes
    while IFS= read -r -d '' l; do
        t=$(readlink -f "$l")
        if [[ $t != "$r/"* || $t == "$r/share" || $t == "$r/share/"* ]]; then
            rm -f "$l"
            echo_warn "Removed $l, it led out of ruTorrent's code to $t"
        fi
    done < <(find "$r" -path "$r/share" -prune -o -type l -print0)
    for g in "${gits[@]}"; do
        # a link swapped into the path before its folder became root's
        [[ $(readlink -f "$g") == "$g" ]] || continue
        if [[ $g == "$r/.git" ]]; then
            # kept until the new one is there
            main_git=1
            continue
        fi
        [[ $g == "$theme/.git" ]] && theme_git=1
        rm -rf "$g"
    done
    [[ -n $theme_git ]] && rm -rf "$theme"
    find "$r" \( -path "$r/share" -o -path "$r/conf/users" \) -prune -o ! -type l \( -type d -o -links 1 \) \
        \( ! -perm -a+r -o -perm /022 \) -exec chmod a+rX,go-w {} +
    for d in "$r"/conf/users/*/; do
        d=${d%/}
        [[ -d $d && ! -L $d ]] || continue
        u=${d##*/}
        local acl="u:www-data:rX"
        if id -u "$u" > /dev/null 2>&1; then acl+=",u:$u:rX"; fi
        if ! { find "$d" ! -type l \( -type d -o -links 1 \) -exec chmod u=rwX,g=rX,o= {} + &&
            find "$d" -type d -exec setfacl -P -m "$acl,${acl//u:/d:u:}" {} + &&
            find "$d" -type f -links 1 -exec setfacl -P -m "$acl" {} +; }; then
            echo_warn "Could not give www-data and $u access to $d"
        fi
    done
    # both write the profile: www-data from the web, the user's rTorrent through initplugins.php
    sed -i 's/^\(\s*\$profileMask\s*=\s*\)0777;/\10770;/' "$r/conf/config.php"

    # share first, root's and closed to www-data: share/users can then no longer be swapped for a link
    # while root changes it. share/users is sticky: www-data creates profiles but cannot replace a user's one
    [[ -L $r/share ]] && rm -f "$r/share"
    mkdir -p "$r/share"
    chown -h root:root "$r/share"
    chmod 0755 "$r/share"
    setfacl -b "$r/share"
    [[ -L $r/share/users ]] && rm -f "$r/share/users"
    mkdir -p "$r/share/users"
    chown -h root:root "$r/share/users"
    chmod 1755 "$r/share/users"
    setfacl -P -m u:www-data:rwx "$r/share/users" || echo_warn "Could not let www-data create ruTorrent profiles"
    for u in $(_get_user_list); do
        id -u "$u" > /dev/null 2>&1 || continue
        d=$r/share/users/$u
        [[ -L $d ]] && rm -f "$d"
        if [[ ! -e $d ]] && ! (cd / && _as_www_data mkdir -m 0770 "$d" "$d"/settings "$d"/torrents "$d"/tmp); then
            echo_warn "Could not create the ruTorrent profile of $u"
        fi
    done
    for d in "$r"/share/users/*; do
        [[ -L $d ]] && rm -f "$d"
        [[ -d $d ]] || continue
        u=${d##*/}
        _rutorrent_profile_acl www-data "$u" "$d" || echo_warn "Could not close the ruTorrent profile $d to other users"
        if id -u "$u" > /dev/null 2>&1; then
            _rutorrent_profile_acl "$u" "$u" "$d" || echo_warn "Could not share the ruTorrent profile $d between $u and www-data"
        fi
    done
    _rutorrent_profiles_nosymfollow

    git config --global --unset-all safe.directory '^/srv/rutorrent/?$' 2> /dev/null
    # also retried at the next run after a failed fetch, from the tag root kept
    if [[ -n $main_git || -f /install/.rutorrent.tag ]]; then
        if [[ -f /install/.rutorrent.tag ]]; then
            _rutorrent_git_again "$(< /install/.rutorrent.tag)"
        else
            rm -rf "$r/.git"
            echo_warn "ruTorrent's version could not be read, box rtx cannot restore its own plugins until ruTorrent is reinstalled"
        fi
    fi
    if [[ -n $theme_git ]]; then
        rutorrent_club_quickbox
    fi
}

# ruTorrent's own .git, fetched again at tag $1, replaces the one www-data owned once it is there. Until then
# there is none: root git never uses the old one
function _rutorrent_git_again() {
    local r=/srv/rutorrent tmp
    tmp=$(mktemp -d -p /srv) || return 1
    if [[ $1 =~ ^v?[0-9][0-9A-Za-z.+-]*$ ]] &&
        GIT_TERMINAL_PROMPT=0 timeout 120 git clone -q --no-checkout --depth 1 -b "$1" https://github.com/Novik/ruTorrent.git "$tmp/r" >> "$log" 2>&1; then
        rm -rf "$r/.git"
        mv "$tmp/r/.git" "$r/.git"
        rm -f /install/.rutorrent.tag
        _rutorrent_report_changes "$1"
    else
        rm -rf "$r/.git"
        echo_warn "ruTorrent's git data could not be fetched again, box rtx cannot restore its own plugins until the next box update"
    fi
    rm -rf "$tmp"
}

# Code a www-data compromise changed before root took it over stays: the tracked files that differ from
# release $1 are reported, but those swizzin rewrites itself and the writable profiles
function _rutorrent_report_changes() {
    local changed
    # --no-checkout left the index empty: filled from the release, the files are left as they are
    rutorrent_git reset -q >> "$log" 2>&1 || return 0
    changed=$(rutorrent_git diff --name-only --diff-filter=MT -- . ':!share' ':!conf/users' ':!conf/config.php' \
        ':!plugins/create/conf.php' ':!plugins/spectrogram/conf.php' ':!plugins/diskspace/action.php' ':!plugins/theme/conf.php' 2>> "$log")
    if [[ -n $changed ]]; then
        echo_warn "These ruTorrent files differ from its release $1, check them or reinstall ruTorrent: ${changed//$'\n'/, }"
    fi
}

# git as root on ruTorrent's own clone only: never a repository found another way, such as a bare one
# www-data could have planted in /srv/rutorrent while it owned it
function rutorrent_git() {
    [[ -d /srv/rutorrent/.git && ! -L /srv/rutorrent/.git && $(stat -c %u /srv/rutorrent/.git) == 0 ]] || return 128
    git -C /srv/rutorrent --git-dir=/srv/rutorrent/.git --work-tree=/srv/rutorrent "$@"
}

# A user can place a link in their own profile that ruTorrent would follow into another user's: share/users
# is mounted again over itself without following links (Linux 5.10+). Where it cannot be, that is recorded
# and said once
function _rutorrent_profiles_nosymfollow() {
    local d=/srv/rutorrent/share/users unit=srv-rutorrent-share-users.mount
    _rutorrent_nosymfollow_on && return 0
    [[ -f /install/.rutorrent.nosymfollow.failed ]] && return 0
    cat > /etc/systemd/system/$unit << EOF
[Unit]
Description=ruTorrent profiles, links in them are not followed

[Mount]
What=$d
Where=$d
Type=none
Options=bind,nosymfollow

[Install]
WantedBy=local-fs.target
EOF
    systemctl daemon-reload
    systemctl enable -q --now "$unit" >> "$log" 2>&1
    _rutorrent_nosymfollow_on && return 0
    rutorrent_profiles_unmount
    touch /install/.rutorrent.nosymfollow.failed
    echo_warn "$d could not be mounted without following links (Linux 5.10 or later): a user can still place a link in their ruTorrent profile that ruTorrent follows into another user's"
}

function _rutorrent_nosymfollow_on() {
    findmnt -rno OPTIONS --mountpoint /srv/rutorrent/share/users 2> /dev/null | grep -qE '(^|,)nosymfollow(,|$)'
}

# Before /srv/rutorrent is removed: rm cannot remove a mount point
function rutorrent_profiles_unmount() {
    local unit=srv-rutorrent-share-users.mount
    [[ -f /etc/systemd/system/$unit ]] || return 0
    systemctl disable -q --now "$unit" >> "$log" 2>&1
    rm -f /etc/systemd/system/$unit
    systemctl daemon-reload
}

# Sets, as $1, the ACL on the files $1 owns in the profile $3 of user $2: www-data and $2 only. A file with
# other hard links is left out
function _rutorrent_profile_acl() {
    local owner=$1 u=$2 d=$3 acl="u:www-data:rwX" dacl="d:u:www-data:rwX" run
    if id -u "$u" > /dev/null 2>&1; then
        acl+=",u:$u:rwX"
        dacl+=",d:u:$u:rwX"
    fi
    acl+=",g::-,o::-"
    dacl+=",d:g::-,d:o::-"
    if [[ $owner == www-data ]]; then run=(_as_www_data); else run=(runuser -u "$owner" --); fi
    (cd / && "${run[@]}" find -P "$d" -user "$owner" \( -type d -exec setfacl -P -m "$acl,$dacl" {} + \
        -o -type f -links 1 -exec setfacl -P -m "$acl" {} + \)) 2>> "$log"
}

# True when rutorrent_perms has something to do
function rutorrent_perms_needed() {
    local r=/srv/rutorrent
    [[ -d $r ]] || return 1
    [[ -n $(find "$r" -path "$r/share" -prune -o \( ! -user root -o -type f -links +1 \) -print -quit) ]] ||
        [[ $(stat -c %U "$r/share" 2> /dev/null) != root || $(stat -c %U "$r/share/users" 2> /dev/null) != root || ! -k $r/share/users ]] ||
        ! getfacl -cp "$r/share/users" 2> /dev/null | grep -q '^user:www-data:rwx' ||
        [[ -f /install/.rutorrent.tag ]] ||
        grep -qE '^\s*\$profileMask\s*=\s*0777;' "$r/conf/config.php" ||
        { ! _rutorrent_nosymfollow_on && [[ ! -f /install/.rutorrent.nosymfollow.failed ]]; }
}

# Installs the club-QuickBox theme from GitHub, or from the copy kept in sources/vendor when GitHub cannot provide it
function rutorrent_club_quickbox() {
    local dest=/srv/rutorrent/plugins/theme/themes/club-QuickBox
    # no credential prompt if the repository went private
    if GIT_TERMINAL_PROMPT=0 timeout 60 git clone --depth 1 -b latest https://github.com/QuickBox/club-QuickBox.git "$dest" >> "$log" 2>&1; then
        return 0
    fi
    rm -rf "$dest"
    echo_warn "Could not download the club-QuickBox theme, installing the copy kept by swizzin"
    cp -r /etc/swizzin/sources/vendor/club-QuickBox "$dest" || {
        echo_error "The club-QuickBox theme could not be installed"
        return 1
    }
    # box update makes sources/ readable by root only
    chmod -R u=rwX,go=rX "$dest"
}

function rutorrent_fm_config() {
    # Reconfigure file manager plugin for ARM64 support
    # rar is not supported on arm, so it needs to be dropped
    if [[ "$(_os_arch)" = "arm64" ]]; then
        cat > /srv/rutorrent/plugins/filemanager/conf.php << 'RUFMC'
<?php

    global $pathToExternals;
    // set with fullpath to binary or leave empty
    $pathToExternals['7zip'] = '/usr/bin/7z';

    $config['mkdperm'] = 755; // default permission to set to new created directories
    $config['show_fullpaths'] = false; // wheter to show userpaths or full system paths in the UI

    $config['textExtensions'] = 'log|txt|nfo|sfv|xml|html';

    // see what 7zip extraction supports as type by file extension
    $config['fileExtractExtensions'] = '(7z|bzip2|t?bz2|tgz|gz(ip)?|iso|img|lzma|rar|tar|t?xz|zip|z01|wim)(\.[0-9]+)?';

    // archive creation, see archiver man page before editing
    // archive.fileExt -> config
    $config['archive']['type'] = [
        '7z' => [
            'bin' => '7zip',
            'compression' => [1, 5, 9],
        ]];

   $config['archive']['type']['zip'] = $config['archive']['type']['7z'];
   $config['archive']['type']['tar'] = $config['archive']['type']['7z'];
   $config['archive']['type']['tar']['has_password'] = false;
   $config['archive']['type']['bz2'] = $config['archive']['type']['tar'];
   $config['archive']['type']['gz'] = $config['archive']['type']['tar'];
   $config['archive']['type']['tar.7z'] = $config['archive']['type']['tar'];
   $config['archive']['type']['tar.bz2'] = $config['archive']['type']['tar'];
   $config['archive']['type']['tar.gz'] = $config['archive']['type']['tar'];
   $config['archive']['type']['tar.xz'] = $config['archive']['type']['tar'];


   // multiple passes for archiving and compression
   $config['archive']['type']['tar.gz']['multipass'] = ['tar', 'gzip'];
   $config['archive']['type']['tar.bz2']['multipass'] = ['tar', 'bzip2'];
   $config['archive']['type']['tar.7z']['multipass'] = ['tar', '7z'];
   $config['archive']['type']['tar.xz']['multipass'] = ['tar', 'xz'];        
RUFMC
    fi
}

function rutorrent_nginx_config() {
    if [[ ! -f /etc/nginx/apps/rutorrent.conf ]]; then
        phpversion=$(php_service_version)
        sock="php${phpversion}-fpm"
        cat > /etc/nginx/apps/rutorrent.conf << RUM
location /rutorrent {
  auth_basic "What's the password?";
  auth_basic_user_file /etc/htpasswd;

  location ~ \.php$ {
    fastcgi_split_path_info ^(.+\.php)(/.+)\$;
    fastcgi_pass unix:/run/php/$sock.sock;
    fastcgi_param SCRIPT_FILENAME \$request_filename;
    include fastcgi_params;
    fastcgi_index index.php;
  }
}
RUM
    fi

    if [[ ! -f /etc/nginx/apps/rindex.conf ]]; then
        cat > /etc/nginx/apps/rindex.conf << RIN
location /rtorrent.downloads {
  alias /home/\$remote_user/torrents/rtorrent;
  disable_symlinks if_not_owner from=/home/\$remote_user;
  include /etc/nginx/snippets/fancyindex.conf;
  auth_basic "What's the password?";
  auth_basic_user_file /etc/htpasswd;
  
  location ~* \.php($|/) {

  }
  # Files that a browser opens as a document able to run scripts (HTML, XML, SVG...,
  # following nginx's mime.types) are sandboxed: their scripts cannot act as the
  # dashboard. An add_header here replaces the server's, so those are repeated.
  location ~* \.(s?html?|xhtml|xml|svgz?|atom|rss|mml|kml|xspf)\$ {
    add_header Content-Security-Policy "sandbox" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
  }
}
RIN
    fi
}

function rutorrent_user_config() {
    users=($(_get_user_list))
    for user in "${users[@]}"; do
        if [[ ! -f /srv/rutorrent/conf/users/${user}/config.php ]]; then
            mkdir -p /srv/rutorrent/conf/users/${user}/
            cat > /srv/rutorrent/conf/users/${user}/config.php << RUU
<?php
\$topDirectory = '/home/${user}';
\$scgi_port = 0;
\$scgi_host = "unix:///var/run/${user}/.rtorrent.sock";
\$XMLRPCMountPoint = "/${user}";
\$quotaUser = "${user}";
?>
RUU
        fi

        if [[ ! -f /etc/nginx/apps/${user}.scgi.conf ]]; then
            cat > /etc/nginx/apps/${user}.scgi.conf << RUC
location /${user} {
include scgi_params;
scgi_pass unix:/var/run/${user}/.rtorrent.sock;
auth_basic "What's the password?";
auth_basic_user_file /etc/htpasswd.d/htpasswd.${user};
}
RUC
        fi
    done
}

function rutorrent_fix_quota() {
    cat > /srv/rutorrent/plugins/diskspace/action.php << 'DSKSP'
<?php
#################################################################################
##  [Quick Box - action.php modified for quota systems use]
#################################################################################
# QUICKLAB REPOS
# QuickLab _ packages:   https://github.com/QuickBox/QB/tree/master/rtplugins/diskspace
# LOCAL REPOS
# Local _ packages   :   ~/QuickBox/rtplugins
# Author             :   QuickBox.IO
# URL                :   https://plaza.quickbox.io
#
#################################################################################
  require_once( '../../php/util.php' );
  if (isset($quotaUser) && file_exists('/install/.quota.lock')) {
    $total = shell_exec("sudo /usr/bin/quota -wu ".$quotaUser."| tail -n 1 | sed -e 's|^[ \t]*||' | awk '{print $3*1024}'");
    $used = shell_exec("sudo /usr/bin/quota -wu ".$quotaUser."| tail -n 1 | sed -e 's|^[ \t]*||' | awk '{print $2*1024}'");
    $free = sprintf($total - $used);
    CachedEcho::send('{ "total": '.$total.', "free": '.$free.' }',"application/json");
  } else {
      CachedEcho::send('{ "total": '.disk_total_space($topDirectory).', "free": '.disk_free_space($topDirectory).' }',"application/json");
  }
?>
DSKSP
}

#Returns all users managed by swizzin as a newline separated list
function _get_user_list() {
    output=""
    for file in $(find /root/ -maxdepth 1 -name '*.info' ! -name .master.info | sort); do
        if [[ -f $file ]]; then
            output+="$(cut -d: -f1 < "$file")\n"
        fi
    done
    output+=$(cut -d: -f1 < /root/.master.info)
    echo -e "$output" | sort | uniq
}
export -f _get_user_list

#Returns the username of the master
function _get_master_username() {
    cut -d: -f1 < /root/.master.info
}
export -f _get_master_username

# True when no terminal can be opened (script, cron, web dashboard): prompts there would wait forever
function _no_terminal() {
    ! { : < /dev/tty; } 2> /dev/null
}

# Will recurse if $pass isn't set or isn't valid
function password_check() {
    ui="$1"
    if [ "$SETUP_USER" = "true" ]; then
        ui="whiptail"
    fi
    #If no password set, then get one
    if [[ -z $pass ]]; then
        # While password isn't confirmed ...
        while [[ -z $confirmedPass ]]; do
            # Get a password
            if [[ $ui = "whiptail" ]]; then
                pass=$(whiptail --passwordbox "Enter new password for $user. Leave empty to generate." 9 40 3>&1 1>&2 2>&3)
                exitstatus=$?
                if [ "$exitstatus" = 1 ]; then exit 1; fi
            else
                echo_query "Enter password for ${user}. (leave empty to generate a password)" "hidden"
                read -rs 'pass'
                echo
            fi
            # Check the password
            if [[ $pass = "" ]]; then
                #If password should be generated, skip the check
                confirmedPass=true
            else
                if [[ $ui = "whiptail" ]]; then
                    pass2=$(whiptail --passwordbox "Please confirm the password" 9 40 3>&1 1>&2 2>&3)
                    exitstatus=$?
                    if [ "$exitstatus" = 1 ]; then exit 1; fi
                else
                    echo_query "Please confirm password" "hidden"
                    read -rs 'pass2'
                    echo
                fi
                if [[ $pass != "$pass2" ]]; then
                    # Restart if they don't match
                    if [[ $ui = "whiptail" ]]; then
                        whiptail --title "Error" --msgbox "Passwords did not match." --ok-button="Try again" 10 50
                    else
                        echo_warn "Passwords did not match. Press enter to try again"
                        read -n 1 -r
                    fi
                else
                    #continue if they're good
                    confirmedPass=true
                fi
            fi
        done
        unset confirmedPass
    fi
    # If password was empty then it needs to be generated
    if [[ -z "${pass}" ]]; then
        # generating one needs a terminal to show it and confirm it was noted
        if _no_terminal; then
            echo_error "No password given: pass it as an argument, box adduser|chpasswd <user> <password>"
            exit 1
        fi
        echo_progress_start "Generating password"
        pass="$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c16)"
        whiptail --title "Generated password" --msgbox "The generated password for $user is:\n$pass \n\nNote this down as this will not be shown again after it is hidden" --ok-button="Hide" 10 70
        while ! whiptail --title "Did you write it down?" --yesno "Just checking, we're not going to show you this password again after you tell us you got it." --defaultno --yes-button "Yeah I got it" --no-button "Let's see it again" 8 78; do
            whiptail --title "Generated password" --msgbox "The generated password for $user is:\n$pass \n\nNote this down as this will not be shown again after it is hidden" --ok-button="Hide" 10 70
        done
        echo_progress_done "Password generated and hidden"
    fi

    #Perform tests. If failure is detected, recurse by unsetting $pass, and running `password_check $ui`
    ## Passwords are stored as user:password, and Deluge keeps them in user:password:level lines
    if [[ $pass == *:* ]]; then
        if [[ $UNATTEND == "true" ]] || _no_terminal; then
            echo_error "Passwords cannot contain a colon (:)."
            exit 1
        fi
        if [[ $ui = "whiptail" ]]; then
            whiptail --title "Error" --msgbox "Passwords cannot contain a colon (:)." --ok-button="Try again" 10 50
        else
            echo_warn "Passwords cannot contain a colon (:). Press enter to try again"
            read -n 1 -r
        fi
        unset pass
        password_check "$1"
        return
    fi
    ##Cracklib test
    if [ "$SKIPCRACKLIB" != "true" ]; then
        echo_progress_start "Checking password strength"
        result=$(cracklib-check <<< "$pass")
        if ! grep -q OK <<< "$result"; then
            crackreason=$(echo "$result" | cut -d':' -f2)
            if _no_terminal; then
                echo_error "Password did not pass cracklib check. Reason: \"${crackreason/ /}\""
                exit 1
            fi
            if [[ $ui = "whiptail" ]]; then
                whiptail --title "Error" --msgbox "Password did not pass cracklib check.\nReason: \"${crackreason/ /}\"" --ok-button="Try again" 10 50
            else
                echo_warn "Password did not pass cracklib check. Reason: \"${crackreason/ /}\". Press enter to try again"
                read -n 1 -r
            fi
            result=""
            unset result
            pass=
            unset pass
            password_check "$1"
        else
            echo_progress_done "Password passed"
        fi
        SKIPCRACKLIB=""
        unset SKIPCRACKLIB
    fi
}

# Will recurse while $user isn't set or isn't valid
function username_check() {
    ui="$ui"
    if [ "$SETUP_USER" = "true" ]; then
        ui="whiptail"
    fi
    if [[ -z $user ]]; then
        if [[ $ui = "whiptail" ]]; then
            user=$(whiptail --inputbox "Enter username for Swizzin \"master\"" 8 40 3>&1 1>&2 2>&3)
            exitstatus=$?
            if [ "$exitstatus" = 1 ]; then exit 1; fi
        else
            echo_query "Enter a name for the new user (CTRL+C to cancel)"
            read -r user
        fi
    fi

    #Perform tests. If failure is set message and set flag
    ## Quick caps check
    error_message=""
    if [[ $user =~ [A-Z] ]]; then
        error_message+="Usernames must not contain capital letters.\n"
        badUsername=true
    fi
    # Check reserved usernames
    badnames=("swizzin" "admin" "www-data" "root" "cydrex" "sudo" "user" "users")
    # Reserving usernames from the names of apps in install folder
    badnames+=($(find /etc/swizzin/scripts/install/ -type f -printf '%f\n' | cut -d. -f1))
    #shellcheck disable=SC2199,SC2076
    if [[ " ${badnames[@]} " =~ " ${user} " ]]; then
        error_message+="$user is a not an allowed username -- please use something else.\n"
        badUsername=true
    fi
    ## Do the complicated regex
    if ! [[ $user =~ ^[a-z_]([a-z0-9_-]{0,31}|[a-z0-9_-]{0,30}\$)$ ]]; then
        error_message+="Usernames must contain no capitals or special characters, start with a letter and be no longer than 32 characters"
        badUsername=true
    fi
    ## Recurse if error found
    if [[ $badUsername = "true" ]]; then
        if _no_terminal; then
            echo_error "$error_message"
            exit 1
        fi
        if [[ $ui = "whiptail" ]]; then
            whiptail --title "Error" --msgbox "$error_message" --ok-button="Try again" 12 50
        else
            echo_warn "${error_message}Please try again"
        fi
        user=
        badUsername=false
        username_check "$1"
    fi
    echo_log_only "Username_check returned"
}

# Writes the sudo rule that lets a user run their own services. sudo only takes A-Z, 0-9 and _ in an alias name
# and stops working for every account on a bad or duplicate one, so the alias is the user name in hex
function _write_user_sudoers() {
    local user="$1" alias tmp
    alias="SWIZZIN_$(printf %s "$user" | od -An -tx1 | tr -d ' 
' | tr a-f A-F)"
    # sudo skips files with a dot in their name, so the draft is never read before it is checked
    tmp=$(mktemp /etc/sudoers.d/.swizzin.XXXXXX) || return 1
    cat > "$tmp" << SUD
Cmnd_Alias   ${alias} = /bin/systemctl stop flood@${user}, /bin/systemctl restart flood@${user}, /bin/systemctl start flood@${user}, /bin/systemctl start rtorrent@${user}, /bin/systemctl stop rtorrent@${user}, /bin/systemctl restart rtorrent@${user}, /bin/systemctl start deluged@${user}, /bin/systemctl stop deluged@${user}, /bin/systemctl restart deluged@${user}, /bin/systemctl start deluge-web@${user}, /bin/systemctl stop deluge-web@${user}, /bin/systemctl restart deluge-web@${user}, /bin/systemctl start irssi@${user}, /bin/systemctl stop irssi@${user}, /bin/systemctl restart irssi@${user}, /bin/systemctl start qbittorrent@${user}, /bin/systemctl stop qbittorrent@${user}, /bin/systemctl restart qbittorrent@${user}, /usr/local/bin/swizzin/box chpasswd ${user}, /usr/local/bin/swizzin/box fix-downloads ${user}

${user}     ALL = (ALL) NOPASSWD: ${alias}
SUD
    if ! visudo -cqf "$tmp" > /dev/null 2>&1; then
        rm -f "$tmp"
        echo_error "The sudo rule for $user is invalid and was not installed"
        return 1
    fi
    chmod 440 "$tmp"
    mv -f "$tmp" /etc/sudoers.d/"$user"
}
export -f _write_user_sudoers

# Web login files: nginx reads them as the www-data user, the panel also reads /etc/htpasswd as swizzin.
# Older installs put every swizzin user in the www-data group, so the group gets nothing and each reader is named in an ACL.
# The ACL and the mode are set in one step: a file closed without its ACL would lock everyone out of the web
# shellcheck disable=SC2154 # log is exported by globals.sh
function _htpasswd_perms() {
    local f
    for f in "$@"; do
        if [[ $f == /etc/htpasswd && -f /install/.panel.lock ]]; then
            setfacl --set u::rw,g::-,o::-,u:www-data:r,u:swizzin:r "$f" >> "$log" 2>&1
        else
            setfacl --set u::rw,g::-,o::-,u:www-data:r "$f" >> "$log" 2>&1
        fi || {
            echo_warn "Could not set an ACL on $f, it stays readable as before"
            continue
        }
        chown root:root "$f"
    done
}
export -f _htpasswd_perms

# Homes are 750 and www-data (nginx, PHP) is in no user's group. www-data lists the home, for ruTorrent's
# folder picker, so it also reads the world-readable files there; the panel (group swizzin) only crosses
# it, to read the free space of disks mounted inside it.
# setfacl runs as the user: a symlink they placed in their home never makes root change another file
function _home_acl() {
    local acl=u:www-data:rx
    if getent group swizzin > /dev/null; then acl+=,g:swizzin:x; fi
    (cd / && runuser -u "$1" -- setfacl -P -m "$acl" "/home/$1")
}
export -f _home_acl

# The clients keep WebUI password hashes, API keys and secrets there, often world-readable: www-data
# lists the home (ruTorrent's folder picker) and the media servers are in the master's group for the
# libraries, neither needs them. Only these entries, never recursively, never the downloads. ~/.sessions
# stays open: ruTorrent reads rtorrent.lock there. As the user, so a link they placed only reaches their
# own files. Prints what it closed, and on stderr what it could not close
function _home_private() {
    # shellcheck disable=SC2016 # expanded by the user's sh
    (cd / && runuser -u "$1" -- sh -c '
        cd "/home/$1" || exit 1
        mkdir -p -m 700 .config .local .cache
        for f in .config .local .cache .irssi .autodl .flood .xmrig .rtorrent.rc nzbget/nzbget.conf; do
            if [ -e "$f" ]; then
                find -H "$f" -maxdepth 0 -perm /077 -user "$(id -u)" -exec chmod go-rwx {} \; -print
                find -H "$f" -maxdepth 0 -perm /077 ! -user "$(id -u)" -printf "%p belongs to %u, it stays readable\n" >&2
            fi
        done' sh "$1")
}
export -f _home_private

# Runs a command as nginx and PHP do once they are in no user's group. To check an access, use _test_as
function _as_www_data() {
    setpriv --reuid=www-data --regid=www-data --clear-groups -- "$@"
}
export -f _as_www_data

# test's arguments, checked as an account ($1) without its groups. The shell's own test asks the kernel:
# the test of rust-coreutils (Ubuntu 26.04) reads the mode bits only and ignores ACLs
function _test_as() {
    local who=$1
    shift
    setpriv --reuid="$who" --regid="$(id -g "$who")" --clear-groups -- sh -c 'test "$@"' sh "$@"
}
export -f _test_as

# Sets ACL entries on a folder ($2) and what is in it: $3 on folders, $4 on the rest. Run as its owner ($1)
# from /, so only what they own and can read is changed, never on another disk mounted inside (rclone,
# FUSE); setfacl leaves entries already right untouched. Prints the first entry of another owner and
# the first error
function _acl_tree() {
    local u=$1 r=$2 mp prune=()
    while read -r mp; do
        if [[ $mp == "$r/"* ]]; then prune+=(-path "$mp" -prune -o); fi
    done < <(findmnt -rno TARGET)
    runuser -u "$u" -- find "$r" -xdev "${prune[@]}" \( -type d ! -readable -prune \) -o ! -type l \( ! -user "$u" -printf 'F %p\n' -o -type d -exec setfacl -P -m "$3" {} + -o -exec setfacl -P -m "$4" {} + \) 2>&1 |
        awk -v u="$u" '{gsub(/[[:cntrl:]]/, "?")} /^F \// {if (!f++) print substr($0, 3) " is not owned by " u ", it keeps its own permissions"; next} {if (!e++) print}'
}
export -f _acl_tree

# The folder a download listing conf serves, e.g. /home/$remote_user/torrents/rtorrent
# shellcheck disable=SC2016 # nginx's $remote_user, literally
function _served_root() {
    [[ -f $1 ]] && sed -nE 's|^\s*alias (/home/\$remote_user/[^;]*[^/;])/?;\s*$|\1|p' "$1" | head -1
}
export -f _served_root

# A folder nginx lists for its user ($2, relative to the home, e.g. torrents/rtorrent): www-data lists its
# parents and reads it, and the default entry keeps what is downloaded there later readable. A folder
# linked elsewhere gets it on its target, through _acl_tree.
# nginx refuses a link whose owner is not its target's: a link root made in the home towards a folder of
# the user (~/torrents -> /mnt/disk2/u) is remade by the user, who could replace it anyway.
# A missing folder, or one behind a broken link (an unmounted disk), is skipped with a message.
# Prints what it skipped, and fails with the reason when www-data still cannot read the folder.
# $3 names another account in place of www-data: rutorrent, whose PHP sends downloads from ruTorrent
function _www_acl_served() {
    local u=$1 rel=$2 who=${3:-www-data} c=/home/$1 r part parts
    [[ -e /home/$u/$rel || -L /home/$u/$rel ]] || return 0
    (
        cd / || exit 1
        IFS=/ read -ra parts <<< "$rel"
        for part in "${parts[@]}"; do
            c+=/$part
            # resolved as the user: box fix-downloads runs this on their request, root would tell them
            # what exists where they cannot look
            r=$(runuser -u "$u" -- readlink -f -- "$c")
            if [[ -z $r ]] || ! runuser -u "$u" -- test -e "$r"; then
                echo "$c leads to a folder that is missing or out of reach of $u (an unmounted disk?): skipped"
                exit 0
            fi
            if [[ -L $c && $(stat -c %U "$c") == root && $(stat -c %U "$r") == "$u" ]]; then
                runuser -u "$u" -- ln -sfn "$(readlink "$c")" "$c"
            fi
            if [[ $c != "/home/$u/$rel" && $(stat -c %U "$r") == "$u" ]]; then
                runuser -u "$u" -- setfacl -P -m "u:$who:rx" "$r"
            fi
        done
        _acl_tree "$u" "$r" "u:$who:rx,d:u:$who:rX" "u:$who:rX"
        _test_as "$who" -r "$r" -a -x "$r" || {
            echo "$who still cannot read $r"
            exit 1
        }
    )
}
export -f _www_acl_served

# Gives a media server's account ($1) $3 (rX, or rwX) on a folder ($2), on what is in it and, through a
# default entry, on what is created there later, and x on each parent its owner also owns (the home).
# Everything is set by the folder's owner, so a link planted there only reaches their own files, and a
# file of another owner keeps its permissions. Checked as the account without its groups: fails with
# the reason when the account still cannot read the folder
function _media_acl() {
    local a=$1 perm=$3 r p o
    r=$(readlink -f -- "$2")
    if [[ ! -d $r ]]; then
        echo "$2 is not a folder"
        return 1
    fi
    # A user could link their folder to another user's: only a path without links is taken, compared
    # after it was resolved, so a link placed later changes nothing
    if [[ $r != "$(realpath -s -m -- "$2")" ]]; then
        echo "$2 goes through a link to $r (owned by $(stat -c %U "$r")): give that path if it is the right folder"
        return 1
    fi
    o=$(stat -c %U "$r")
    if [[ $o == root ]]; then
        echo "$r belongs to root: give it to the user whose media it holds, or set the ACL yourself"
        return 1
    fi
    (
        cd / || exit 1
        p=$r
        while
            p=${p%/*}
            [[ -n $p ]]
        do
            if [[ $(stat -c %U "$p") == "$o" ]]; then runuser -u "$o" -- setfacl -P -m "u:$a:x" "$p"; fi
        done
        # the owner keeps what the server creates there (Calibre-web adds books)
        _acl_tree "$o" "$r" "u:$a:${perm/X/x},d:u:$a:$perm,d:u:$o:rwX" "u:$a:$perm"
        _test_as "$a" -r "$r" -a -x "$r" || {
            echo "$a still cannot read $r: check the permissions of its parents"
            exit 1
        }
    )
}
export -f _media_acl

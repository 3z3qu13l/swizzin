#!/bin/bash
# Ombi: install from GitHub releases (and move installs off its retired apt repository), upgrade with rollback, purge

#shellcheck source=sources/functions/utils
. /etc/swizzin/sources/functions/utils

# Debian 13 and later: apt.ombi.app's key is bound with SHA1 signatures, which their apt verifier (sqv)
# refuses since 2026-02-01, so the repository cannot be verified. Ombi comes from its GitHub releases there.
function ombi_from_github() {
    [[ $(_os_distro) == debian && ! $(_os_codename) =~ ^(bullseye|bookworm)$ ]]
}

# Whether the apt package is installed: once removed, dpkg still knows it by its config files
function ombi_from_apt() {
    [[ $(dpkg-query -W -f='${db:Status-Status}' ombi 2> /dev/null) == installed ]]
}

function ombi_apt_source() {
    apt_key_install https://apt.ombi.app/pub.key /usr/share/keyrings/ombi-archive-keyring.gpg || {
        echo_error "The Ombi signing key could not be downloaded"
        return 1
    }
    echo "deb [signed-by=/usr/share/keyrings/ombi-archive-keyring.gpg] https://apt.ombi.app/master jessie main" > /etc/apt/sources.list.d/ombi.list
}

# Ombi 4.53 moved ClientApp/dist/index.html to dist/browser/, but its postinst still chowns the old path and fails.
# A link at the old path lets the postinst finish, and still gives the ombi user the index.html it rewrites.
function ombi_index_link() {
    local index=/opt/Ombi/ClientApp/dist/index.html
    if [[ ! -e $index && ! -L $index ]]; then
        mkdir -p /opt/Ombi/ClientApp/dist
        ln -s browser/index.html "$index"
    fi
}

# What the apt package sets up besides /opt/Ombi: the ombi user, /etc/Ombi for its data, the service
function ombi_github_service() {
    adduser --system --disabled-password --disabled-login --home /var/empty --no-create-home --quiet --group ombi
    if [[ ! -d /etc/Ombi ]]; then
        mkdir -p /etc/Ombi
        chown ombi:nogroup /etc/Ombi
    fi
    # its databases hold the API keys of Plex and the *arr apps
    chmod 750 /etc/Ombi
    # not /etc/systemd/system/ombi.service: update/ombi.sh deletes that one
    mkdir -p /usr/local/lib/systemd/system
    cat > /usr/local/lib/systemd/system/ombi.service << UNIT
[Unit]
Description=Ombi - PMS Requests System
After=network-online.target

[Service]
User=ombi
Group=nogroup
WorkingDirectory=/opt/Ombi/
ExecStart=/opt/Ombi/Ombi --storage /etc/Ombi/
Type=simple
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
    # removing the apt package masks the unit
    systemctl unmask -q ombi 2> /dev/null
    systemctl daemon-reload
}

# Apt's sources for Ombi, useless where it cannot verify them
function ombi_drop_apt_source() {
    rm -f /etc/apt/sources.list.d/ombi.list /etc/apt/preferences.d/ombi /usr/share/keyrings/ombi-archive-keyring.gpg
}

# Downloads and unpacks the latest release in $ombi_tmp/new, next to /opt/Ombi
function _ombi_fetch() {
    local arch version
    case "$(_os_arch)" in
        amd64) arch=x64 ;;
        arm64) arch=arm64 ;;
        armhf) arch=arm ;;
        *)
            echo_error "$(_os_arch) is not supported by Ombi"
            return 1
            ;;
    esac
    version=$(github_latest_version Ombi-app/Ombi)
    if [[ -z $version ]]; then
        echo_error "Could not find the latest Ombi release"
        return 1
    fi
    echo_progress_start "Downloading Ombi ${version}"
    ombi_tmp=$(mktemp -d /opt/Ombi.XXXXXX)
    mkdir "$ombi_tmp/new"
    # Ombi writes the base URL into its index.html when it starts: without it Ombi would not start
    if ! curl -fsSL "https://github.com/Ombi-app/Ombi/releases/download/${version}/linux-${arch}.tar.gz" -o "$ombi_tmp/ombi.tar.gz" >> "$log" 2>&1 ||
        ! tar xzf "$ombi_tmp/ombi.tar.gz" -C "$ombi_tmp/new" >> "$log" 2>&1 || [[ ! -x $ombi_tmp/new/Ombi ]] ||
        [[ ! -f $ombi_tmp/new/ClientApp/dist/browser/index.html ]]; then
        rm -rf "$ombi_tmp"
        echo_error "Could not download Ombi"
        return 1
    fi
    rm -f "$ombi_tmp/ombi.tar.gz"
    # its version.json lags behind the release
    echo "${version#v}" > "$ombi_tmp/new/.swizzin-version"
    chown -R root: "$ombi_tmp/new"
    chmod 755 "$ombi_tmp/new"
    echo_progress_done
}

# Puts the release of $ombi_tmp/new in /opt/Ombi, the old one back if a rename fails. Ombi is stopped.
function _ombi_swap() {
    local old=
    if [[ -e /opt/Ombi ]]; then
        old=$ombi_tmp/old
        mv /opt/Ombi "$old" || return 1
    fi
    if ! mv "$ombi_tmp/new" /opt/Ombi; then
        [[ -n $old ]] && mv "$old" /opt/Ombi
        return 1
    fi
    chown ombi:nogroup /opt/Ombi/ClientApp/dist/browser/index.html
    rm -rf "$ombi_tmp"
}

# Installs or upgrades Ombi from its latest GitHub release
function ombi_github_upgrade() {
    local active=
    _ombi_fetch || return 1
    ombi_github_service
    systemctl -q is-active ombi && active=1 && systemctl stop ombi
    if ! _ombi_swap; then
        rm -rf "$ombi_tmp"
        [[ -n $active ]] && systemctl start ombi
        echo_error "Could not install the new Ombi, the old one is still there"
        return 1
    fi
    [[ -n $active ]] && systemctl start ombi
    return 0
}

# Purges the apt package with /etc/Ombi set aside: its purge deletes that folder, which holds Ombi's data.
# A package only removed would keep that purge waiting for any clean-up of removed packages.
function ombi_purge_package() {
    local keep=/etc/Ombi.swizzin-keep
    if [[ -e $keep ]]; then
        echo_error "$keep exists: move Ombi's data back from it first"
        return 1
    fi
    if [[ -d /etc/Ombi ]]; then mv /etc/Ombi "$keep" || return 1; fi
    if ! dpkg -P ombi >> "$log" 2>&1; then
        [[ -d $keep ]] && mv "$keep" /etc/Ombi
        echo_error "Could not remove the apt package of Ombi (see $log)"
        return 1
    fi
    [[ -d $keep ]] && mv "$keep" /etc/Ombi
    return 0
}

# What the apt package pulled in stays: apt would otherwise autoremove it, Ombi needs libicu
function _ombi_keep_dependencies() {
    local p
    for p in $(dpkg-query -W -f='${Depends}' ombi 2> /dev/null | tr ',' '\n' | sed 's/([^)]*)//g; s/|.*//; s/:.*//; s/[[:space:]]//g'); do
        [[ $(dpkg-query -W -f='${db:Status-Status}' "$p" 2> /dev/null) == installed ]] && apt-mark manual "$p" >> "$log" 2>&1
    done
}

# A server that has Ombi from apt moves to the GitHub release. /etc/Ombi, its data, stays as it is.
function ombi_migrate_to_github() {
    local active=
    # downloaded first: a failure leaves the apt install untouched
    _ombi_fetch || return 1
    systemctl -q is-active ombi && active=1
    _ombi_keep_dependencies
    systemctl stop ombi
    if ! ombi_purge_package; then
        rm -rf "$ombi_tmp"
        [[ -n $active ]] && systemctl start ombi
        return 1
    fi
    ombi_github_service
    if ! _ombi_swap; then
        rm -rf "$ombi_tmp"
        echo_error "Could not install Ombi from GitHub (see $log): run box upgrade ombi"
        return 1
    fi
    systemctl enable -q ombi >> "$log" 2>&1
    [[ -n $active ]] && systemctl start ombi
    return 0
}

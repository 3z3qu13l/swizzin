#!/bin/bash
# transfer.sh helpers

transfersh_bin=/opt/transfersh/transfersh
# the credentials nginx hands transfer.sh, so that only nginx can upload: 127.0.0.1 is open to every account
transfersh_env=/etc/transfersh.env

function _transfersh_port() {
    grep -o -- '--listener 127.0.0.1:[0-9]*' /etc/systemd/system/transfersh.service | cut -d: -f2
}

# Waits up to 30 seconds for transfer.sh to answer
function _transfersh_wait() {
    local i port
    port=$(_transfersh_port)
    for ((i = 0; i < 15; i++)); do
        curl -sf --max-time 5 -o /dev/null "http://127.0.0.1:${port}/health.html" && return 0
        sleep 2
    done
    return 1
}

# Downloads the latest transfer.sh release to $transfersh_bin, checked against its published sha256.
# A release that does not start goes back to the previous one.
function transfersh_download_latest() {
    local arch version name tmp sum active= dir=${transfersh_bin%/*}
    case "$(_os_arch)" in
        amd64) arch=amd64 ;;
        arm64) arch=arm64-v8a ;;
        armhf) arch=armv7 ;;
        *)
            echo_error "$(_os_arch) is not supported by transfer.sh"
            exit 1
            ;;
    esac
    version=$(github_latest_version dutchcoders/transfer.sh)
    if [[ -z $version ]]; then
        echo_error "Could not find the latest transfer.sh release"
        exit 1
    fi
    name="transfersh-${version}-linux-${arch}"

    echo_progress_start "Downloading transfer.sh ${version}"
    mkdir -p "$dir"
    tmp=$(mktemp "${transfersh_bin}.XXXXXX")
    sum=$(curl -fsSL "https://github.com/dutchcoders/transfer.sh/releases/download/${version}/${name}.sha256sum" 2>> "$log" | awk '{ print $1 }')
    if [[ -z $sum ]] || ! curl -fsSL "https://github.com/dutchcoders/transfer.sh/releases/download/${version}/${name}" -o "$tmp" >> "$log" 2>&1 ||
        ! echo "${sum}  ${tmp}" | sha256sum -c --status; then
        rm -f "$tmp"
        echo_error "Could not download transfer.sh"
        exit 1
    fi
    chmod 755 "$tmp"
    systemctl -q is-active transfersh && active=1 && systemctl stop transfersh
    if [[ -f $transfersh_bin ]]; then
        cp -p "$transfersh_bin" "${transfersh_bin}.old"
        cp -p "$dir/.swizzin-version" "$dir/.swizzin-version.old" 2> /dev/null
    fi
    mv "$tmp" "$transfersh_bin"
    echo "$version" > "$dir/.swizzin-version"
    echo_progress_done
    if [[ -n $active ]]; then
        systemctl start transfersh
        if [[ -f ${transfersh_bin}.old ]] && ! _transfersh_wait; then
            systemctl stop transfersh
            mv "${transfersh_bin}.old" "$transfersh_bin"
            mv "$dir/.swizzin-version.old" "$dir/.swizzin-version" 2> /dev/null
            systemctl start transfersh
            echo_error "transfer.sh ${version} did not start: the previous release is back"
            exit 1
        fi
    fi
    rm -f "${transfersh_bin}.old" "$dir/.swizzin-version.old"
    return 0
}

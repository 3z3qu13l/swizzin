#!/bin/bash

# Sudo rules letting the web server read the disk quotas
function quota_sudoers() {
    local tmp=/etc/sudoers.d/quota.tmp
    local rules="Cmnd_Alias   QUOTA = /usr/bin/quota

www-data     ALL = (ALL) NOPASSWD: QUOTA
rutorrent    ALL = (ALL) NOPASSWD: QUOTA"
    # rutorrent: ruTorrent's PHP pool, whose diskspace plugin calls it at every refresh.
    # keep the web server's frequent sudo calls out of the auth log where sudo allows it
    # (sudo-rs, on Ubuntu 26.04, does not know these settings)
    printf '%s\n' "Defaults:www-data !logfile" "Defaults:www-data !syslog" "Defaults:www-data !pam_session"         "Defaults:rutorrent !logfile" "Defaults:rutorrent !syslog" "Defaults:rutorrent !pam_session" "" "$rules" > "$tmp" && chmod 0440 "$tmp"
    local written=$?
    if [[ $written -eq 0 ]] && ! visudo -cqf "$tmp" > /dev/null 2>&1; then
        printf '%s\n' "$rules" > "$tmp"
        written=$?
    fi
    # a broken sudoers file would lock sudo for everyone; a truncated one would drop the quota rules
    if [[ $written -eq 0 ]] && visudo -cqf "$tmp" > /dev/null 2>&1; then
        mv -f "$tmp" /etc/sudoers.d/quota
    else
        rm -f "$tmp"
        echo_error "Could not write the quota sudo rules"
        return 1
    fi
}

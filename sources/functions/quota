#!/bin/bash

# Sudo rules letting the web server read the disk quotas
function quota_sudoers() {
    local who=(www-data) w rules defaults=()
    # ruTorrent's own account, as swizzin created it: its diskspace plugin calls quota at every refresh
    if [[ -f /install/.rutorrent.account && $(id -u rutorrent 2> /dev/null) == "$(< /install/.rutorrent.account)" ]]; then who+=(rutorrent); fi
    rules="Cmnd_Alias   QUOTA = /usr/bin/quota
"
    for w in "${who[@]}"; do
        rules+="
$w     ALL = (ALL) NOPASSWD: QUOTA"
        defaults+=("Defaults:$w !logfile" "Defaults:$w !syslog" "Defaults:$w !pam_session")
    done
    # keep the web server's frequent sudo calls out of the auth log where sudo allows it
    # (sudo-rs, on Ubuntu 26.04, does not know these settings)
    _install_sudoers quota "$(printf '%s\n' "${defaults[@]}" "" "$rules")" "$rules" || {
        echo_error "Could not write the quota sudo rules"
        return 1
    }
}

function _get_next_port_from_json() {
    key="$1"
    defaultport="$2"
    relpath=".config/transmission-daemon/settings.json"
    highestvalue=$defaultport
    wasincreased='false'

    for d in /home/*/; do
        value=""
        confpath="${d}${relpath}"
        if [[ -f $confpath ]]; then
            paramrr=".[\"$key\"]"
            value=$(jq -r "$paramrr" < "$confpath")
        fi
        if [[ -n $value ]]; then
            if [[ $value -ge $highestvalue ]]; then
                highestvalue=$value
                wasincreased='true'
            fi
        fi
    done

    if [[ $wasincreased = 'true' ]]; then
        ((highestvalue++))
    fi

    echo "$highestvalue"
}

function whiptail_transmission_source() {
    if [[ -z $TRANSMISSION_SOURCE ]]; then
        distribution=$(lsb_release -is)
        if [[ $distribution =~ "Ubuntu" ]]; then
            TRANSMISSION_SOURCE=$(whiptail --title "Install Software" --menu "Choose which source to install Transmission from" --ok-button "Continue" --nocancel 10 50 2 \
                PPA "(Directly from Transmission)" \
                Repo "(Packaged and tested by Ubuntu)" \
                3>&1 1>&2 2>&3)
        else
            TRANSMISSION_SOURCE="Repo"
        fi
        echo_log_only "TRANSMISSION_SOURCE = $TRANSMISSION_SOURCE"
        export TRANSMISSION_SOURCE
    fi

}

function _install_transmission() {
    whiptail_transmission_source
    distribution=$(lsb_release -is)
    if [[ $TRANSMISSION_SOURCE = "PPA" ]]; then
        if [[ ! $distribution =~ 'Ubuntu' ]]; then
            echo_warn "PPA not available on this system, using normal repo."
            return 1
        else
            echo_progress_start "Adding Transmission PPA"
            add-apt-repository ppa:transmissionbt/ppa -y >> "$log" 2>&1
            echo_progress_done "PPA Added"
        fi
    fi
    apt_install transmission-cli transmission-common transmission-daemon
    echo_progress_start "Disabling default non-multiuser service"
    systemctl disable -q --now transmission-daemon >> "$log" 2>&1
    echo_progress_done
}

# QuickBox's web interface, served through TRANSMISSION_WEB_HOME so the packaged interface stays untouched.
# Any failure keeps the interface that is already served.
function transmission_web_control_install() {
    local dir=/opt/transmission-web-control version tmp stock status=0
    . /etc/swizzin/sources/functions/utils
    version=$(github_latest_version QuickBox/transmission-web-control)
    if [[ -z $version ]]; then
        echo_warn "Could not find the latest transmission-web-control release, keeping the current web interface"
        return 1
    fi
    echo_progress_start "Installing the transmission-web-control interface ${version}"
    tmp=$(mktemp -d)
    local url=https://github.com/QuickBox/transmission-web-control/releases/download/${version}
    if wget -q -P "$tmp" "${url}/transmission-web-control-${version}.tar.gz" "${url}/SHA256SUMS" >> "$log" 2>&1 &&
        (cd "$tmp" && sha256sum -c SHA256SUMS --ignore-missing >> "$log" 2>&1) &&
        rm -rf "${dir}.new" && mkdir -p "${dir}.new" &&
        tar --no-same-owner --no-same-permissions -xzf "$tmp/transmission-web-control-${version}.tar.gz" --strip-components=1 -C "${dir}.new" >> "$log" 2>&1 &&
        [[ -f ${dir}.new/index.html ]]; then
        # the tab icon comes from the packaged interface (public_html in 4.x, web in 3.x)
        for stock in /usr/share/transmission/public_html /usr/share/transmission/web; do
            [[ -d $stock/images ]] && cp -a "$stock/images" "${dir}.new/" && break
        done
        # root-owned, so no local user can change the JavaScript served on the swizzin domain
        chown -R root:root "${dir}.new"
        rm -rf "${dir}.old"
        [[ -d $dir ]] && mv "$dir" "${dir}.old"
        mv "${dir}.new" "$dir" && rm -rf "${dir}.old"
        mkdir -p /etc/systemd/system/transmission@.service.d
        cat > /etc/systemd/system/transmission@.service.d/web-control.conf << EOF
[Service]
Environment=TRANSMISSION_WEB_HOME=${dir}
EOF
        systemctl daemon-reload
        echo_progress_done "Interface ${version} installed"
    else
        rm -rf "${dir}.new"
        echo_warn "transmission-web-control could not be installed, keeping the current web interface"
        status=1
    fi
    rm -rf "$tmp"
    return $status
}

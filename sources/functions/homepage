# Prints the local address of an app, empty when its port cannot be found.
# Widgets and status checks query the apps from the server itself.
function _homepage_local_url() {
    local app=$1 user=$2 port
    case $app in
        rutorrent)
            echo "https://127.0.0.1/rutorrent"
            ;;
        flood)
            port=$(sed -n 's/^FLOOD_PORT=//p' "/home/${user}/.config/flood/env" 2> /dev/null)
            [[ -n $port ]] && echo "http://127.0.0.1:${port}/flood"
            ;;
        transmission)
            # Transmission 5 renames the key to rpc_port
            port=$(jq -r '.["rpc-port"] // .rpc_port // empty' "/home/${user}/.config/transmission-daemon/settings.json" 2> /dev/null)
            [[ -n $port ]] && echo "http://127.0.0.1:${port}"
            ;;
        qbittorrent)
            port=$(qbittorrent_webui_setting "$user" Port)
            [[ -n $port ]] && echo "http://127.0.0.1:${port}"
            ;;
        deluge)
            port=$(jq -r '.port // empty' "/home/${user}/.config/deluge/web.conf" 2> /dev/null)
            [[ -n $port ]] && echo "http://127.0.0.1:${port}"
            ;;
        filebrowser)
            port=$(grep -oP 'proxy_pass https://127\.0\.0\.1:\K[0-9]+' /etc/nginx/apps/filebrowser.conf 2> /dev/null)
            [[ -n $port ]] && echo "https://127.0.0.1:${port}/filebrowser"
            ;;
        netdata)
            echo "http://127.0.0.1:19999"
            ;;
        *) ;;
    esac
    return 0
}

# Prints the status badge and widget of an app.
# The badge queries the app itself, not nginx: its login would answer for a stopped app.
function _homepage_app_extras() {
    local app=$1 user=$2 url
    url=$(_homepage_local_url "$app" "$user")
    [[ -n $url ]] || return 0
    # No badge for ruTorrent (behind the nginx login) nor Transmission: before 4.0 it locks
    # its RPC for everyone after 100 requests without a password, until it restarts.
    case $app in
        # answers 401 at once, rate limited to 200 calls per 5 minutes per address
        flood) echo "        siteMonitor: ${url}/api/auth/verify" ;;
        qbittorrent | deluge | filebrowser) echo "        siteMonitor: ${url}" ;;
        *) ;;
    esac
    case $app in
        rutorrent | flood | qbittorrent | deluge | transmission | filebrowser | netdata) ;;
        *) return 0 ;;
    esac
    echo "        widget:"
    echo "          type: ${app}"
    echo "          url: ${url}"
    case $app in
        netdata) ;;
        # deluge only knows a password
        deluge) echo "          password: {{HOMEPAGE_FILE_SWIZZIN_PASSWORD}}" ;;
        *)
            echo "          username: $(jq -Rn --arg u "$user" '$u')"
            echo "          password: {{HOMEPAGE_FILE_SWIZZIN_PASSWORD}}"
            ;;
    esac
}

# Glances feeds the System graphs: the Debian service is switched to its web API, local only
homepage_glances_conf="/etc/systemd/system/glances.service.d/swizzin.conf"

function _homepage_glances_api() {
    if dpkg --compare-versions "$(dpkg-query -W -f='${Version}' glances 2> /dev/null)" ge 4; then
        echo 4
    else
        echo 3
    fi
}

function homepage_glances() {
    local port owner=""
    # removing Homepage only removes Glances when swizzin installed it
    if [[ -f $homepage_glances_conf ]]; then
        grep -q '^# installed by swizzin' "$homepage_glances_conf" && owner="# installed by swizzin"
    elif ! dpkg -s glances > /dev/null 2>&1; then
        owner="# installed by swizzin"
    fi
    apt_install glances
    # the web server needs packages Debian only recommends, Glances exits without them
    if [[ $(_homepage_glances_api) == 4 ]]; then
        apt_install python3-uvicorn python3-jinja2
    else
        apt_install python3-bottle
    fi

    port=$(grep -oP -- '-p \K[0-9]+' "$homepage_glances_conf" 2> /dev/null)
    [[ -n $port ]] || port=$(port 10001 32001)
    mkdir -p "${homepage_glances_conf%/*}"
    cat > "$homepage_glances_conf" << EOF
${owner}
[Service]
User=glances
DynamicUser=yes
ExecStart=
ExecStart=/usr/bin/glances -w --disable-webui --disable-process -B 127.0.0.1 -p ${port}
EOF
    systemctl daemon-reload
    systemctl enable -q glances
    systemctl restart glances
    for _ in {1..15}; do
        ss -Htln "sport = :${port}" | grep -q . && return 0
        sleep 1
    done
    echo_warn "Glances did not start, the System graphs will show an error (see journalctl -u glances)"
}

# vnStat, a swizzin dependency, records the traffic. A timer writes its figures to a
# file that nginx serves to Homepage, local only, since vnStat has no web API.
homepage_vnstat_file="/var/lib/homepage-vnstat/vnstat.json"

function homepage_vnstat() {
    mkdir -p "${homepage_vnstat_file%/*}"
    cat > /etc/systemd/system/homepage-vnstat.service << EOF
[Unit]
Description=Traffic figures from vnStat for Homepage

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'iface=\$(ip route show default | grep -m1 -oP "\\\\bdev \\\\K\\\\S+"); vnstat -i "\$iface" --json | jq -c ".interfaces[0].traffic | {today: (.day[-1] // {rx: 0, tx: 0} | {rx, tx}), month: (.month[-1] // {rx: 0, tx: 0} | {rx, tx}), total: (.total | {rx, tx})}" > ${homepage_vnstat_file}.tmp && mv -f ${homepage_vnstat_file}.tmp ${homepage_vnstat_file}'
EOF
    cat > /etc/systemd/system/homepage-vnstat.timer << EOF
[Unit]
Description=Refresh the vnStat figures for Homepage

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable -q --now homepage-vnstat.timer
    systemctl start homepage-vnstat.service
}

# CPU, memory and network graphs over the last 15 minutes (90 points, one every 10 s)
function _homepage_system() {
    local port iface metric name api minutes listen period
    port=$(grep -oP -- '-p \K[0-9]+' "$homepage_glances_conf" 2> /dev/null)
    [[ -n $port ]] || return 0
    api=$(_homepage_glances_api)
    iface=$(ip route show default | grep -m1 -oP '\bdev \K\S+')
    echo "- System:"
    for metric in cpu memory ${iface:+network:${iface}}; do
        case $metric in
            cpu) name=CPU ;;
            memory) name=Memory ;;
            *) name=Network ;;
        esac
        echo "    - ${name}:"
        echo "        widget:"
        echo "          type: glances"
        echo "          url: http://127.0.0.1:${port}"
        echo "          version: ${api}"
        echo "          metric: ${metric}"
        echo "          refreshInterval: 10000"
        echo "          pointsLimit: 90"
    done
    # second row, under CPU then Memory
    echo "    - Load average:"
    echo "        widget:"
    echo "          type: customapi"
    echo "          url: http://127.0.0.1:${port}/api/${api}/load"
    echo "          refreshInterval: 10000"
    echo "          mappings:"
    for minutes in 1 5 15; do
        echo "            - field: min${minutes}"
        echo "              label: ${minutes} min"
        echo "              format: float"
    done
    # Glances answers a plain string such as "3 days, 1:02:03", shown as is
    echo "    - Uptime:"
    echo "        widget:"
    echo "          type: customapi"
    echo "          url: http://127.0.0.1:${port}/api/${api}/uptime"
    echo "          refreshInterval: 60000"
    echo "          mappings:"
    echo "            - label: Uptime"
    # under Network: today, this month and total traffic recorded by vnStat
    [[ -f $homepage_vnstat_file ]] || return 0
    listen=$(grep -oP 'listen \K[0-9]+' /etc/nginx/sites-enabled/homepage 2> /dev/null | head -1)
    [[ -n $listen ]] || return 0
    echo "    - Traffic:"
    echo "        widget:"
    echo "          type: customapi"
    echo "          url: https://127.0.0.1:${listen}/vnstat.json"
    echo "          refreshInterval: 300000"
    echo "          display: list"
    echo "          mappings:"
    for period in today month total; do
        case $period in
            today) name=Today ;;
            month) name="This month" ;;
            *) name=Total ;;
        esac
        # one line per period: down, then up next to it
        echo "            - field: ${period}.rx"
        echo "              label: ${name} ↓↑"
        echo "              format: bytes"
        echo "              additionalField:"
        echo "                field: ${period}.tx"
        echo "                format: bytes"
    done
}

# Rewrites services.yaml from the installed apps and the master password file.
# Called by box after every install, remove and password change.
function homepage_services() {
    local user conf app name path group icon system current=""
    user=$(_get_master_username)
    conf="/home/${user}/.config/homepage"
    mkdir -p "$conf"

    # Homepage pastes the file content into the YAML as is, a JSON string keeps any password valid YAML
    (
        umask 077
        _get_user_password "$user" | tr -d '\n' | jq -Rs . | tr -d '\n' > "${conf}/.swizzin.password.tmp"
        mv -f "${conf}/.swizzin.password.tmp" "${conf}/swizzin.password"
    )

    # replaces Homepage's sample bookmarks, the file then belongs to the user
    if [[ ! -f ${conf}/bookmarks.yaml ]]; then
        echo "# Your own links, see https://gethomepage.dev/configs/bookmarks/" > "${conf}/bookmarks.yaml"
        echo "[]" >> "${conf}/bookmarks.yaml"
    fi
    # default layout: one full width row of three cards per group
    if [[ ! -f ${conf}/settings.yaml ]]; then
        cat > "${conf}/settings.yaml" << 'EOF'
# Your settings, see https://gethomepage.dev/configs/settings/
title: swizzin
layout:
  System:
    style: row
    columns: 3
    useEqualHeights: true
  Downloads:
    style: row
    columns: 3
  Media:
    style: row
    columns: 3
  Tools:
    style: row
    columns: 3
EOF
    fi

    {
        echo "# Generated by swizzin after each box install, remove or chpasswd: manual changes are overwritten."
        echo "# Put your own links in bookmarks.yaml."
        system=$(_homepage_system)
        [[ -n $system ]] && echo "$system"
        while IFS='|' read -r app name path group icon; do
            [[ -f /install/.${app}.lock ]] || continue
            if [[ $group != "$current" ]]; then
                echo "- ${group}:"
                current=$group
            fi
            echo "    - ${name}:"
            # mdi-* icons come from Material Design, the others from the dashboard icons
            [[ $icon == mdi-* ]] || icon="${icon}.png"
            echo "        icon: ${icon}"
            echo "        href: /swizzin${path}"
            _homepage_app_extras "$app" "$user"
        done < <(_homepage_apps | sort -t'|' -k4,4 -s)
        [[ -n $current || -n $system ]] || echo "[]"
    } > "${conf}/.services.yaml.tmp"
    chown -R "${user}:" "$conf"
    # Homepage reads the file on every request, never let it see a half written one
    mv -f "${conf}/.services.yaml.tmp" "${conf}/services.yaml"
}

#!/bin/bash
# Homepage dashboard helpers

homepage_dir="/opt/homepage"

#shellcheck source=sources/functions/npm
. /etc/swizzin/sources/functions/npm
#shellcheck source=sources/functions/utils
. /etc/swizzin/sources/functions/utils

# Downloads and builds the latest Homepage release in $homepage_dir
function homepage_build() {
    local user version
    user=$(_get_master_username)
    version=$(github_latest_version gethomepage/homepage)
    if [[ -z $version ]]; then
        echo_error "Could not find the latest Homepage release"
        exit 1
    fi
    npm_install
    if ! command -v pnpm > /dev/null 2>&1; then
        echo_progress_start "Installing pnpm"
        npm install --quiet --global pnpm >> "$log" 2>&1
        echo_progress_done
    fi

    # built aside, the current version keeps running if anything fails
    local src="${homepage_dir}.src" new="${homepage_dir}.new" active
    rm -rf "$src" "$new"
    echo_progress_start "Downloading Homepage ${version}"
    git clone -q --depth 1 -b "$version" https://github.com/gethomepage/homepage.git "$src" >> "$log" 2>&1 || {
        echo_error "Failed to download Homepage"
        rm -rf "$src"
        exit 1
    }
    echo_progress_done

    # the Next.js build needs more memory than small servers have
    check_swap_on
    echo_progress_start "Building Homepage (this can take a few minutes)"
    (
        cd "$src" || exit 1
        export NEXT_TELEMETRY_DISABLED=1
        pnpm install --frozen-lockfile && pnpm build
    ) >> "$log" 2>&1 || {
        echo_error "Failed to build Homepage"
        rm -rf "$src"
        check_swap_off
        exit 1
    }
    check_swap_off
    # same layout as the official image: standalone server, static assets and config skeleton
    mkdir -p "${new}/.next" "${new}/src"
    cp -a "${src}/.next/standalone/." "$new"
    cp -a "${src}/.next/static" "${new}/.next/"
    cp -a "${src}/public" "$new"
    cp -a "${src}/src/skeleton" "${new}/src/"
    rm -rf "$src"
    chown -R "${user}:" "$new"
    echo_progress_done

    active=$(systemctl is-active homepage 2> /dev/null)
    systemctl stop homepage > /dev/null 2>&1
    rm -rf "$homepage_dir"
    mv "$new" "$homepage_dir"
    [[ $active == active ]] && systemctl start homepage
    return 0
}


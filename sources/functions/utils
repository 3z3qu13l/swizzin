#!/bin/bash
# Small shared helpers: rar, rm_if_exists, port, RAM and swap checks, installed apps, latest GitHub release,
# nginx reload, unit removal, per-user binary apps

# Handles rar installation for all distros and architectures
function install_rar() {
    # Checking for unrar because that's what we really need. rar itself is quite problematic to install, but is installed whenever possible.
    if ! which unrar > /dev/null; then
        case "$(_os_arch)" in
            "amd64")
                apt_install rar unrar
                ;;
            "arm64")
                apt_install unrar
                ;;
            *)
                # Debian (non-free) and Ubuntu (multiverse) build unrar for their other architectures too, and
                # keep it updated. unrar is optional: the install goes on without it
                apt_install --ignore-errors unrar
                ;;
        esac

        if ! which rar > /dev/null; then
            echo_warn "Rar (for creating archives) is not supported on $(_os_distro)-$(_os_arch).\nInstallation will continue."
        fi
    else
        echo_log_only "Rar seems to be installed"
    fi
}

# Removes a file or a directory in case it exists
#\
# Parameters:
# $1 = Full path of directory, fath or link to remove
function rm_if_exists() {
    path="$1"
    if [[ -e "$path" ]]; then
        rm -rf "$path"
    fi
}

# Finds a random free port between a range
# \
# Parameters:
# $1 = Lower bound
# $2 = Upper bounf
# \
# Returns an integer
function port() {
    LOW_BOUND=$1
    UPPER_BOUND=$2
    comm -23 <(seq ${LOW_BOUND} ${UPPER_BOUND} | sort) <(ss -Htan | awk '{print $4}' | cut -d':' -f2 | sort -u) | shuf | head -n 1
}

# Checks if there is enough RAM and Swap in total
# \
# Parameters:
# $1 = The amount of total space to require
function check_ram() {
    if [[ -z $1 ]]; then
        echo_error "Must specify a value to compare"
        return 1
    fi
    if ! dpkg -s bc > /dev/null 2>&1; then
        apt_install bc
    fi
    ramtotal=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    swaptotal=$(grep SwapTotal /proc/meminfo | awk '{print $2}')
    total=$(echo "$swaptotal + $ramtotal" | bc -l | numfmt --from-unit=1024)
    needs=$(echo $1 | numfmt --from=iec)
    if [[ $needs -gt $total ]]; then
        false
    else
        true
    fi
}

# Enables a temporary 2GB swap file
# \
# Exits if cannot continue
function check_swap_on() {
    if ! check_ram 4G; then
        echo_progress_start "Setup is enabling the use of a temporary 2GB swap file"
        dd if=/dev/zero of=/.swapfile bs=1M count=2048 > /dev/null 2>&1 || {
            echo_error "Cannot continue with install because swap file could not be created. Does device have 2GB of free space?"
            exit 1
        }
        mkswap /.swapfile > /dev/null 2>&1
        swapon /.swapfile > /dev/null 2>&1
        echo_progress_done 'Swap enabled'
    fi
}

# Disables the temporary swap file
function check_swap_off() {
    if [[ $swap == "true" ]]; then
        swapoff /.swapfile > /dev/null 2>&1
        rm -f /.swapfile > /dev/null 2>&1
    fi
}

# Returns a list of installed apps
_get_installed_apps() {
    find /install -type f -name .\*.lock | awk -F. '{print $2}' | sort
}

function github_latest_version() {
    # Argument expects the author/repo format
    # e.g. swizzin/swizzin
    # Prints the tag releases/latest redirects to. Nothing, and a failure, when GitHub cannot be reached
    # (curl then gives back the address it was asked, ending in "latest") or the repository has no release
    # (it redirects to the release list).
    local url
    url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${1}/releases/latest") || return 1
    [[ $url == */releases/tag/* ]] || return 1
    echo "${url##*/}"
}

# An app that moved from a templated <app>@ unit to <app>.service: drops a template left behind,
# warns when the app still runs from it. $1 = app, $2 = its name for the user
function legacy_template_unit() {
    local app=$1 name=$2
    [[ -f /etc/systemd/system/${app}@.service ]] || return 0
    if [[ -f /etc/systemd/system/${app}.service ]]; then
        rm -f "/etc/systemd/system/${app}@.service"
        systemctl daemon-reload
    else
        echo_warn "${name} still runs from its ${app}@ service, which is no longer supported. Back up its settings, run systemctl disable --now ${app}@$(_get_master_username) and delete /etc/systemd/system/${app}@.service, then box remove ${app} && box install ${app}"
    fi
}

# github_release_asset <owner/repo> <regex>: prints the first download URL of the latest release matching the regex (grep -E). Nothing, and a failure, when there is none
function github_release_asset() {
    local url
    url=$(curl -fsSL "https://api.github.com/repos/${1}/releases/latest" | jq -r '.assets[]?.browser_download_url' | grep -E -- "$2" | head -n 1)
    [[ -n $url ]] || return 1
    echo "$url"
}

# nginx_reload: reloads nginx when it is installed, output to $log
function nginx_reload() {
    if [[ -f /install/.nginx.lock ]]; then
        systemctl reload nginx >> "$log" 2>&1
    fi
}

# remove_unit <unit>...: stops and disables each service, deletes /etc/systemd/system/<unit>.service, then reloads systemd once
function remove_unit() {
    local unit
    for unit in "$@"; do
        systemctl disable --now -q "$unit" >> "$log" 2>&1
        rm -f /etc/systemd/system/"$unit".service
    done
    systemctl daemon-reload
}

# upgrade_peruser_app <app>: downloads the latest release with <app>_download_latest (sources/functions/<app>), then restarts <app>@<user> of every user
function upgrade_peruser_app() {
    local app=$1 user
    if [[ ! -f /install/.${app}.lock ]]; then
        echo_error "${app} doesn't appear to be installed!"
        exit 1
    fi
    #shellcheck source=/dev/null
    . /etc/swizzin/sources/functions/"$app"
    "${app}_download_latest"
    echo_progress_start "Restarting ${app} services"
    for user in $(_get_user_list); do
        echo_log_only "Restarting ${app} for $user"
        systemctl try-restart "${app}@${user}"
    done
    echo_progress_done "Service restarted"
    echo_success "${app} upgraded"
}

# remove_peruser_app <app> [<file>...]: stops <app>@<user> and deletes ~/.config/<app> of every user, then the unit, /usr/bin/<app>, the given files, the nginx confs and the lock
function remove_peruser_app() {
    local app=$1 user
    shift
    for user in $(_get_user_list); do
        systemctl disable --now -q "${app}@${user}"
        rm -rf "/home/${user}/.config/${app}"
    done
    rm -f "/etc/systemd/system/${app}@.service" "/usr/bin/${app}" "$@"
    systemctl daemon-reload -q
    if [[ -f /install/.nginx.lock ]]; then
        rm -f "/etc/nginx/apps/${app}.conf" /etc/nginx/conf.d/*."${app}".conf
        systemctl reload nginx >> "$log" 2>&1
    fi
    rm "/install/.${app}.lock"
}
